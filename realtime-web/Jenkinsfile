pipeline {
    agent any

    parameters {
        // Deploy target
        string(name: 'DEPLOY_DIR',   defaultValue: 'D:\\apps\\findig-service\\realtime-web', description: 'Path to deploy on Windows server')
        string(name: 'PM2_HOME',     defaultValue: 'C:\\ProgramData\\pm2', description: 'PM2 home directory')
        string(name: 'PM2_APP_NAME', defaultValue: 'realtime-web', description: 'PM2 process name')

        // Server runtime
        string(name: 'WEB_PORT',     defaultValue: '3008', description: 'Port that Express server listens on')
        string(name: 'SERVICE_HOST', defaultValue: 'http://127.0.0.1:9090', description: 'Backend realtime-service URL (proxied under /api)')

        // React build-time env (REACT_APP_* are baked into static bundle at build)
        string(name: 'REACT_APP_SERVICE_HOST', defaultValue: '/api/realtime-service', description: 'API base path used by React app')
        string(name: 'REACT_APP_API_USER',     defaultValue: 'admin', description: 'Basic-auth username for API calls')
        password(name: 'REACT_APP_API_KEY',    defaultValue: '', description: 'Basic-auth password / API key for React app')
    }

    environment {
        DEPLOY_DIR = "${params.DEPLOY_DIR}"
        PM2_HOME   = "${params.PM2_HOME}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build React App') {
            steps {
                dir('realtime-web') {
                    bat 'npm ci'
                    withEnv([
                        "REACT_APP_SERVICE_HOST=${params.REACT_APP_SERVICE_HOST}",
                        "REACT_APP_API_USER=${params.REACT_APP_API_USER}",
                        "REACT_APP_API_KEY=${params.REACT_APP_API_KEY}"
                    ]) {
                        // build:windows avoids the Linux-only "rm -rf build &&" prefix
                        bat 'npm run build:windows'
                    }
                }
            }
        }

        stage('Generate ecosystem.config.js') {
            steps {
                script {
                    def ecosystemContent = """module.exports = {
  apps: [
    {
      name: "${params.PM2_APP_NAME}",
      script: "server.js",
      env: {
        WEB_PORT: "${params.WEB_PORT}",
        SERVICE_HOST: "${params.SERVICE_HOST}"
      }
    }
  ]
}
"""
                    writeFile file: 'realtime-web/ecosystem.config.js', text: ecosystemContent
                }
            }
        }

        stage('Stop PM2') {
            steps {
                bat "pm2 stop ${params.PM2_APP_NAME} 2>nul & exit 0"
                bat "pm2 delete ${params.PM2_APP_NAME} 2>nul & exit 0"
            }
        }

        stage('Deploy Files') {
            steps {
                bat "if not exist %DEPLOY_DIR% mkdir %DEPLOY_DIR%"

                // React static build output
                bat """
                    robocopy realtime-web\\build %DEPLOY_DIR%\\build /E /PURGE
                    if %ERRORLEVEL% GEQ 8 exit 1
                    exit 0
                """

                // Express server — use server/server.js as the entry point
                bat "copy /Y realtime-web\\server\\server.js %DEPLOY_DIR%\\server.js"

                // server/package.json has Express deps (not root package.json which is React)
                bat "copy /Y realtime-web\\server\\package.json %DEPLOY_DIR%\\package.json"
                bat "copy /Y realtime-web\\server\\package-lock.json %DEPLOY_DIR%\\package-lock.json"

                // ecosystem config generated above
                bat "copy /Y realtime-web\\ecosystem.config.js %DEPLOY_DIR%\\ecosystem.config.js"
            }
        }

        stage('Install Server Dependencies') {
            steps {
                bat "cd /d %DEPLOY_DIR% && npm ci --omit=dev --prefer-offline"
            }
        }

        stage('Start PM2') {
            steps {
                bat "cd /d %DEPLOY_DIR% && pm2 start ecosystem.config.js"
                bat 'pm2 save'
            }
        }
    }

    post {
        success {
            bat 'pm2 list'
            echo "Deployed ${params.PM2_APP_NAME} on port ${params.WEB_PORT} to ${params.DEPLOY_DIR} successfully!"
        }
        failure {
            echo 'Deployment failed — check the logs above.'
        }
    }
}
