pipeline {
    agent any

    parameters {
        // Deploy target
        string(name: 'DEPLOY_DIR',    defaultValue: 'D:\\apps\\findig-service\\realtime-service', description: 'Path to deploy on Windows server')
        string(name: 'PM2_HOME',      defaultValue: 'C:\\ProgramData\\pm2', description: 'PM2 home directory')
        string(name: 'PM2_APP_NAME',  defaultValue: 'realtime-service', description: 'PM2 process name')

        // App
        string(name: 'PORT',          defaultValue: '9090',              description: 'HTTP port')
        string(name: 'APP_PREFIX',    defaultValue: 'realtime-service',  description: 'App URL prefix')
        string(name: 'NODE_ENV',      defaultValue: 'production',        description: 'Node environment')

        // Auth
        string(name: 'WEB_USER_AUTH',   defaultValue: 'admin',   description: 'Basic-auth username for web UI')
        password(name: 'WEB_USER_PASS', defaultValue: '',        description: 'Basic-auth password for web UI')
        password(name: 'API_SECRET_PASS', defaultValue: '',      description: 'API secret key')

        // Database
        string(name: 'DB_HOST',     defaultValue: 'localhost',  description: 'MySQL host')
        string(name: 'DB_PORT',     defaultValue: '3306',       description: 'MySQL port')
        string(name: 'DB_USER',     defaultValue: 'root',       description: 'MySQL user')
        password(name: 'DB_PASS',   defaultValue: '',           description: 'MySQL password')
        string(name: 'DB_DRIVER',   defaultValue: 'mysql2',     description: 'DB driver (mysql | mysql2)')
        string(name: 'DB_APP_NAME', defaultValue: 'Stock Realtime', description: 'App database name')
        string(name: 'DB_POS_NAME', defaultValue: '',           description: 'POS database name')
        string(name: 'DB_CRM_NAME', defaultValue: '',           description: 'CRM database name')
        string(name: 'DB_BOR_NAME', defaultValue: '',           description: 'BOR database name')

        // Tools
        string(name: 'MYSQLDUMP_PATH', defaultValue: 'C:\\MySQL\\bin', description: 'Path to mysqldump.exe directory')

        // Migration
        choice(name: 'MIGRATE', choices: ['none', 'discount', 'price', 'all'], description: 'Run migration script after deploy: none | discount (migrate-discount.js) | price (migrate-price.js) | all')
    }

    environment {
        DEPLOY_DIR = "${params.DEPLOY_DIR}"
        PM2_HOME   = "${params.PM2_HOME}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('realtime-service') {
                    bat 'npm ci'
                }
            }
        }

        stage('Generate ecosystem.config.js') {
            steps {
                dir('realtime-service') {
                    script {
                        def ecosystemContent = """module.exports = {
  apps: [
    {
      name: "${params.PM2_APP_NAME}",
      script: "bin/www",
      env: {
        PORT: "${params.PORT}",
        APP_PREFIX: "${params.APP_PREFIX}",
        NODE_ENV: "${params.NODE_ENV}",
        dbConfig: "PRODUCTION",
        WEB_USER_AUTH: "${params.WEB_USER_AUTH}",
        WEB_USER_PASS: "${params.WEB_USER_PASS}",
        API_SECRET_PASS: "${params.API_SECRET_PASS}",
        DB_HOST: "${params.DB_HOST}",
        DB_PORT: "${params.DB_PORT}",
        DB_USER: "${params.DB_USER}",
        DB_PASS: "${params.DB_PASS}",
        DB_DRIVER: "${params.DB_DRIVER}",
        DB_APP_NAME: "${params.DB_APP_NAME}",
        DB_POS_NAME: "${params.DB_POS_NAME}",
        DB_CRM_NAME: "${params.DB_CRM_NAME}",
        DB_BOR_NAME: "${params.DB_BOR_NAME}",
        MYSQLDUMP_PATH: "${params.MYSQLDUMP_PATH}"
      }
    }
  ]
}
"""
                        writeFile file: 'ecosystem.config.js', text: ecosystemContent
                    }
                }
            }
        }

        stage('Stop PM2') {
            steps {
                bat "pm2 stop ${params.PM2_APP_NAME} 2>nul & exit 0"
                bat "pm2 delete ${params.PM2_APP_NAME} 2>nul & exit 0"
            }
        }

        stage('Deploy Files') {
            steps {
                // Ensure deploy dirs exist
                bat "if not exist %DEPLOY_DIR%\\logs mkdir %DEPLOY_DIR%\\logs"

                // Sync source — exclude node_modules, logs, .git, .env* (handled separately)
                bat """
                    robocopy realtime-service\\src %DEPLOY_DIR%\\src /E /PURGE
                    if %ERRORLEVEL% GEQ 8 exit 1
                    exit 0
                """
                bat """
                    robocopy realtime-service\\bin %DEPLOY_DIR%\\bin /E /PURGE
                    if %ERRORLEVEL% GEQ 8 exit 1
                    exit 0
                """
                bat """
                    robocopy realtime-service\\templates %DEPLOY_DIR%\\templates /E /PURGE
                    if %ERRORLEVEL% GEQ 8 exit 1
                    exit 0
                """
                bat """
                    robocopy realtime-service\\scripts %DEPLOY_DIR%\\scripts /E /PURGE
                    if %ERRORLEVEL% GEQ 8 exit 1
                    exit 0
                """

                // Package manifest for npm ci on server
                bat "copy /Y realtime-service\\package.json %DEPLOY_DIR%\\package.json"
                bat "copy /Y realtime-service\\package-lock.json %DEPLOY_DIR%\\package-lock.json"

                // ecosystem.config.js generated above
                bat "copy /Y realtime-service\\ecosystem.config.js %DEPLOY_DIR%\\ecosystem.config.js"
            }
        }

        stage('Install Production Dependencies') {
            steps {
                bat "cd /d %DEPLOY_DIR% && npm ci --omit=dev --prefer-offline"
            }
        }

        stage('Run Migrations') {
            when {
                expression { params.MIGRATE != 'none' }
            }
            steps {
                script {
                    if (params.MIGRATE == 'discount' || params.MIGRATE == 'all') {
                        echo 'Running migrate-discount.js ...'
                        bat "cd /d %DEPLOY_DIR% && node scripts/migrate-discount.js"
                    }
                    if (params.MIGRATE == 'price' || params.MIGRATE == 'all') {
                        echo 'Running migrate-price.js ...'
                        bat "cd /d %DEPLOY_DIR% && node scripts/migrate-price.js"
                    }
                }
            }
        }

        stage('Start PM2') {
            steps {
                bat "cd /d %DEPLOY_DIR% && pm2 start ecosystem.config.js"
                bat 'pm2 save'
            }
        }
    }

    post {
        success {
            bat 'pm2 list'
            echo "Deployed ${params.PM2_APP_NAME} to ${params.DEPLOY_DIR} successfully!"
        }
        failure {
            echo 'Deployment failed — check the logs above.'
        }
    }
}
